{
  "$description": "Typographie relevée sur mbayoumkeur.shop : titres en serif expressif, texte en sans-serif lisible.",
  "fontFamily": {
    "display": {
      "value": "'Fraunces', Georgia, serif",
      "role": "Titres (graisse 800), gros chiffres"
    },
    "sans": {
      "value": "'Source Sans 3', system-ui, sans-serif",
      "role": "Texte courant, boutons, navigation"
    }
  },
  "fontWeight": {
    "regular": {
      "value": 400,
      "role": "Texte courant"
    },
    "semibold": {
      "value": 600,
      "role": "Boutons, libellés"
    },
    "bold": {
      "value": 700,
      "role": "Élément actif de la navigation"
    },
    "display-extrabold": {
      "value": 800,
      "role": "Titres Fraunces (variable 100–900)"
    }
  },
  "fontSize": {
