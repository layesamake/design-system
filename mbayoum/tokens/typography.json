    },
    "lead": {
      "value": "1.125rem"
    },
    "title-sm": {
      "value": "1.25rem"
    },
    "title": {
      "value": "1.5rem"
    },
    "h2": {
      "value": "1.875rem",
      "role": "Titres de section (Fraunces 800)"
    },
    "h1": {
      "value": "clamp(1.55rem, 3.6vw, 3rem)",
      "role": "Titre d'accueil ; 2.9rem sur mobile large"
    },
    "display": {
      "value": "3.75rem",
      "role": "Très gros titres (jusqu'à 6rem)"
    }
  },
  "lineHeight": {
    "body": {
      "value": 1.5
    },
    "heading": {
      "value": 0.98,
      "role": "Titre d'accueil très serré"
    }
